# ===== 服务器（框架原有变量）=====
ENV_PRODUCT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=80
SERVER_NAME=pingatlas
PROJECT_NAME=pingatlas
LOG_LEVEL=info

# ===== Globalping =====
# 上游 API 根地址（不带 /v1）
GP_API_URL=https://api.globalping.io
# 服务端 access token：登录用户的请求在本地额度用尽后由后端代理并注入此 token
# 留空则完全禁用代理降级（前端只显示「我的额度」一条，登录按钮仍可用）
GP_TOKEN=
# 上游请求超时（毫秒）
GP_TIMEOUT=30000

# ===== OIDC 登录（OIDC_ISSUER / CLIENT_ID / CLIENT_SECRET / REDIRECT_URI 四项齐全才启用登录）=====
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 如 https://pingatlas.example/api/auth/callback
OIDC_REDIRECT_URI=
OIDC_SCOPE=openid profile email
# 用户名取自 userinfo 的哪个 claim（Keycloak 为 preferred_username）
OIDC_USERNAME_CLAIM=preferred_username
# SSO 提供商名称，显示在登录弹窗按钮上；留空使用本地化默认文案
OIDC_PROVIDER_NAME=
# SSO 用户中心地址；配置后登录时右上角用户名变为可点击链接。只接受 http/https
OIDC_ACCOUNT_URL=
# 登出 SSO 时的 IdP 回跳地址；留空则自动取 OIDC_REDIRECT_URI 的站点根
OIDC_POST_LOGOUT_REDIRECT_URI=

# ===== 会话 =====
# 会话签名密钥：启用登录（OIDC 四项齐全）时必填，至少 32 字节；未启用登录可留空。
# 填了就一定会校验长度。生成：openssl rand -base64 48
SESSION_SECRET=
SESSION_COOKIE_NAME=pa_session
# 会话有效期（秒），默认 7 天
SESSION_TTL=604800

# ===== 静态资源 =====
# 留空自动解析（生产 dist/public，开发 public）
STATIC_DIR=
